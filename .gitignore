# Editors / OS
.DS_Store
*.swp

# Build output
/kagaz
/kagaz-mcp
/bin/
/dist/
.build/
*.o

# Agent scratch (not part of the project)
.superpowers/

# Swift
#
# Package.resolved is intentionally NOT ignored: these are executable
# packages (kagaz-machelper, kagaz-machelper-mlx), not libraries, and
# machelper-mlx pins the MLX stack -- losing that lockfile would cost build
# reproducibility. Commit it like any other lockfile.
.swiftpm/

# Never commit secrets
.env
.env.*
*.pem
*.key
*.p12
